# Neon Postgres
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Chain / RPC
DEPLOYMENT_CHAIN_ID=51
INDEXER_RPC_URL=https://rpc.apothem.network
# Sync cursor floor is deployment51.startBlock from @vexdc/contracts
# (Apothem redeploy 2026-09-10 → 86585078). Rebuild that package after address updates.

# Auth for /api/sync and /api/keeper (Vercel Cron and GitHub Action use Authorization: Bearer $CRON_SECRET)
CRON_SECRET=replace-me

# Keeper wallet (KEEPER_ROLE on FeeDistributor via SystemAccess)
KEEPER_PRIVATE_KEY=

# Optional: Mode B FeeSplitter skim target (falls back to deployment.feeSplitter)
# FEE_SPLITTER=0xeeeb530EBaBB698386fDaf21449CFdCBC56215b5

# Optional reward tokens for skim (comma-separated). Defaults to deployment wxdc + usdc.
# REWARD_TOKENS=0x56408DC41E35d3E8E92A16bc94787438df9387a1,0x0A9f7e55493058f69DB3Fc2a0E27CFA13C8dAC1F

# CORS — web app origin allowed for GET APIs
# CORS_ORIGIN=http://localhost:3000
