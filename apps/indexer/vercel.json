{
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm --filter @vexdc/contracts build && pnpm --filter @vexdc/indexer build",
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/keeper",
      "schedule": "0 22 * * 3"
    },
    {
      "path": "/api/keeper",
      "schedule": "5 0 * * 4"
    }
  ]
}
