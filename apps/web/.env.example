NEXT_PUBLIC_CHAIN_ID=51
NEXT_PUBLIC_RPC_URL=https://rpc.apothem.network
NEXT_PUBLIC_INDEXER_URL=http://localhost:3001
# Privy app id (dashboard.privy.io) — enables email OTP login, embedded
# wallets, and the Privy wallet modal. Unset = plain wagmi fallback.
NEXT_PUBLIC_PRIVY_APP_ID=
# WalletConnect cloud id — used by Privy for mobile wallets / QR, and by the
# wagmi fallback when Privy is not configured.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
