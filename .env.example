# RPC endpoints
XDC_RPC_URL=https://rpc.xinfin.network
XDC_APOTHEM_RPC_URL=https://rpc.apothem.network

# Block explorer verification (xdcscan / blocksscan)
XDCSCAN_API_KEY=

# Deployer — use a hardware wallet or a keystore file in production.
# forge script ... --account <keystore-name>   (preferred)
# DEPLOYER_PRIVATE_KEY is for local anvil runs ONLY.
DEPLOYER_PRIVATE_KEY=

# Deployment configuration (addresses)
WXDC=0x951857744785E80e2De051c32EE7b25f9c458C42
TIMELOCK=
GUARDIAN=
TREASURY=
KEEPER=

# Escrow launch parameters
MAX_PENALTY_BPS=5000
PENALTY_SPLIT_BPS=2000
