# RPC endpoints
XDC_RPC_URL=https://rpc.xinfin.network
XDC_APOTHEM_RPC_URL=https://rpc.apothem.network

# Block explorer verification (xdcscan / blocksscan)

# Deployer — use a hardware wallet or a keystore file in production.
# forge script ... --account <keystore-name>   (preferred)
# DEPLOYER_PRIVATE_KEY is for local anvil / Apothem scripts ONLY (never mainnet).
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ACCOUNT=deployer

# --- Mainnet (chain 50) ---
# WXDC=0x951857744785E80e2De051c32EE7b25f9c458C42

# --- Apothem (chain 51) ---
# Canonical Apothem WXDC (deposit/withdraw wrapper). Confirm before mainnet cutover.
WXDC=0x56408DC41E35d3E8E92A16bc94787438df9387a1
# USDC is deployed by `make deploy-apothem-mocks` (MockERC20) — paste the printed address:
# USDC=
# REWARD_TOKENS=$WXDC,$USDC

TIMELOCK=
GUARDIAN=
TREASURY=
KEEPER=
# Set after core deploy — paste from deployments/51.json (Apothem example below).
# SYSTEM_ACCESS=0x5F16a238a3ACCFAD02Dd3C51BCd2696397256222
# REVENUE_REGISTRY=0xc34bD940313529E1239694F4E6290049F99322eA
# REVENUE_REGISTRY_IMPL=0x83C5fed1eCCBb4981b735Dbf79e191BF16c65dA9
# FEE_DISTRIBUTOR=0x5BD90bFc4943e12Df81A9a1F03B344689481237E
# FEE_DISTRIBUTOR_IMPL=0x116FE1C8c938072f6Eac77297CBFE0AAa4615acf
# VOTING_ESCROW=0x159444CFDB6CEbb5d6924833A0F56Cc5231Dae50
# VE_VOTES_ADAPTER=0xB83F2fc7b784681654Aed11A7195bbe00663Ba5C
# FEE_SPLITTER=0xeeeb530EBaBB698386fDaf21449CFdCBC56215b5
# ZAP_DEPOSITOR=0x589173ed591aDcb3Ed373032b03CC7580e4cE7eD
# START_BLOCK=86585078

# Escrow launch parameters
MAX_PENALTY_BPS=5000
PENALTY_SPLIT_BPS=2000

# --- Indexer / keeper (apps/indexer) ---
# DATABASE_URL=postgresql://...
# CRON_SECRET=
# KEEPER_PRIVATE_KEY=
# INDEXER_RPC_URL=https://rpc.apothem.network
# DEPLOYMENT_CHAIN_ID=51
# Sync startBlock comes from @vexdc/contracts deployment51 (86585078 on Apothem).
